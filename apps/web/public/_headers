# CAD Fixer production response headers.
#
# Consumed by Cloudflare Workers Static Assets as CONFIGURATION. These rules are
# the cross-origin isolation contract: without COOP and COEP the browser
# withholds SharedArrayBuffer and conservative repair fails closed.
#
# Stage 5C-1A-R1 froze the reason this file is sufficient on its own: Cloudflare
# does NOT apply _headers to responses generated by Worker code, and CAD Fixer
# ships no Worker code. Adding a Worker entrypoint or enabling run_worker_first
# would silently move these headers out of this file.
#
# The same contract is asserted executably by scripts/release-server.mjs and by
# the Stage 5B end-to-end suites.

/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The shell is revalidated so a new release is never masked by a cached
# document pointing at hashed chunks that no longer exist.
/index.html
  Cache-Control: no-cache

# Every asset under /assets/ carries a content hash in its name, so a changed
# file is a changed URL and the response may be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
