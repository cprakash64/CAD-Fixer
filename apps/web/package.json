{
  "name": "@cadfixer/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CAD Fixer browser application shell.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:harness": "vite build --config vite.harness.config.ts",
    "preview": "vite preview",
    "preview:harness": "vite preview --config vite.harness.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/workers/tsconfig.json && tsc --noEmit -p src/workers/node-tests/tsconfig.json && tsc --noEmit -p e2e-harness/tsconfig.json && tsc --noEmit -p e2e-harness/worker/tsconfig.json"
  },
  "dependencies": {
    "@cadfixer/file-formats": "*",
    "@cadfixer/geometry-runtime": "*",
    "@cadfixer/mesh-core": "*",
    "@cadfixer/mesh-topology": "*",
    "@cadfixer/shared": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4"
  }
}
