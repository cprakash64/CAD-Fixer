node_modules/
dist/
# The end-to-end harness's build output. Named differently from `dist/` on
# purpose — it lives OUTSIDE the application's output directory so a stale
# harness build can never be served as, or mistaken for, the application.
dist-e2e-harness/
coverage/
playwright-report/
test-results/
.vite/
*.tsbuildinfo

.DS_Store
.env
.env.*
!.env.example

.idea/
.vscode/*
!.vscode/extensions.json

# Machine-local Claude Code permissions. The shared project rules in CLAUDE.md
# and the review agents in .claude/agents/ are committed; this file is not.
.claude/settings.local.json

# Stage 3A-2 geometry-kernel bakeoff.
#
# Upstream sources, the Emscripten SDK, and build trees are FETCHED by the
# pinned scripts in experiments/repair-kernels/scripts, never committed: they
# are gigabytes, they belong to their upstreams, and committing them would make
# the licence position of this repository unclear. What IS committed is the
# scripts, our bindings, our patches, the manifests, and the results.
experiments/repair-kernels/.toolchain/
experiments/repair-kernels/*/upstream/
experiments/repair-kernels/*/build/
experiments/repair-kernels/*/build-native/
# Stage 3A-3B browser harness scratch: prepared cases and raw browser output.
# Intermediates between the prepare, drive and validate steps; the committed
# artefact is docs/repair/bakeoff/browser-*.json.
experiments/browser-harness/.cases/
experiments/repair-kernels/*/artifacts/*.wasm
experiments/repair-kernels/*/artifacts/*.js
experiments/repair-kernels/geogram/artifacts/geogram-reference

# Stage 3C-1A self-intersection research artifacts. Reproducible from the pinned
# sources by the commands in experiments/self-intersection/README.md, and large.
# What IS committed is the harness, the corpus and the results.
experiments/self-intersection/artifacts/
