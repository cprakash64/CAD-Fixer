/**
 * Types for the shared deterministic mesh generators.
 *
 * The implementation is plain `.mjs` on purpose — the same file is served to
 * the browser AND imported by Node, so the geometry a candidate sees is
 * generated by exactly the code the test reasons about. A `.ts` source would
 * need a build step before the browser could load it, which would reintroduce
 * the bundler this harness deliberately avoids.
 *
 * This declaration is what lets the Playwright specs import it without an
 * implicit `any`.
 */

export interface GeneratedMesh {
  readonly positions: Float64Array;
  readonly triangles: Uint32Array;
}

export interface SphereChoice {
  readonly segments: number;
  readonly rings: number;
  readonly vertexCount: number;
  readonly triangleCount: number;
  readonly bytes: number;
  readonly delta: number;
}

export function transferBytes(vertexCount: number, triangleCount: number): number;

export function uvSphere(
  segments: number,
  rings: number,
  radius?: number,
  centre?: readonly [number, number, number],
): GeneratedMesh;

export function torus(
  major: number,
  minor: number,
  majorSegments: number,
  minorSegments: number,
  centre?: readonly [number, number, number],
): GeneratedMesh;

export function openedSphere(segments: number, rings: number, radius?: number): GeneratedMesh;

export function crackedGrid(side: number, gap: number): GeneratedMesh;

export function sphereForBytes(targetBytes: number): SphereChoice | null;
