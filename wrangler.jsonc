{
  // CAD Fixer — Cloudflare Workers Static Assets deployment.
  //
  // Stage 5C-1A-R1 selected Workers Static Assets over Cloudflare Pages. Every
  // field below was validated against node_modules/wrangler/config-schema.json
  // for the pinned Wrangler version; nothing here is speculative.
  //
  // THIS WORKER RUNS NO CODE. There is deliberately no "main", so every request
  // is answered directly from the uploaded static assets. That is load-bearing:
  // Cloudflare does not apply _headers to responses generated by Worker code,
  // so introducing an entrypoint would silently drop cross-origin isolation and
  // break conservative repair in production only.
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "cad-fixer",

  // No Worker code runs, so this date gates no runtime behaviour. It is
  // required for a deployable Worker and is pinned rather than floating.
  "compatibility_date": "2026-09-11",

  // No stable production route. cad-fixer.<subdomain>.workers.dev must NOT
  // exist: Stage 5C-1B1 creates a controlled preview only, and public
  // promotion is a later, explicit decision.
  "workers_dev": false,

  // Enabled EXPLICITLY. preview_urls defaults to the value of workers_dev, so
  // omitting this would inherit `false` and produce no preview URL at all.
  "preview_urls": true,

  "assets": {
    "directory": "./apps/web/dist",

    // Stated explicitly even though false is the default. This is the single
    // switch that would route requests through Worker code and bypass
    // _headers; making it visible means a future change to it is a visible
    // change in review rather than an omission.
    "run_worker_first": false,
  },

  // Deliberately absent: main, routes, route, assets.binding, vars, secrets,
  // kv_namespaces, d1_databases, r2_buckets, durable_objects, queues, triggers,
  // services, observability. CAD Fixer has no server state of any kind.
}
