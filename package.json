{
  "name": "cad-fixer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first browser application for repairing and preparing 3D printing meshes.",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check:node": "node scripts/check-node-version.js",
    "dev": "npm run dev --workspace @cadfixer/web",
    "prebuild": "npm run check:node",
    "build": "npm run build --workspace @cadfixer/web",
    "preview": "npm run preview --workspace @cadfixer/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run check:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench:stl": "vitest run --config vitest.bench.config.ts",
    "preverify": "npm run check:node",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "bench:topology": "vitest run --config vitest.bench.config.ts scripts/topology.bench-suite.ts",
    "bench:pipeline": "vitest run --config vitest.bench.config.ts scripts/pipeline.bench-suite.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
